# ============================================
# Shopply Application Environment Variables
# ============================================
# Copy this file to .env and update values for your environment

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=5000
API_VERSION=v1
APP_URL=https://shopply.co.za
CORS_ORIGIN=https://shopply.co.za

# ============================================
# Database Configuration
# ============================================
# MongoDB (Primary Database)
MONGODB_URI=mongodb+srv://seefeesaw:UJoY54Sivn9QMoRI@cluster0.0vnossd.mongodb.net/?appName=Cluster0

# PostgreSQL (Alternative - if using)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopply
DB_USER=postgres
DB_PASSWORD=UJoY54Sivn9QMoRI

# MySQL (Alternative - if using)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=shopply
# DB_USER=root
# DB_PASSWORD=

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# WhatsApp Business API Configuration
# ============================================
WHATSAPP_API_TYPE=cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v18.0

# WhatsApp Webhook Configuration
WHATSAPP_WEBHOOK_VERIFY_TOKEN=shopply_verify_token_2024
WHATSAPP_WEBHOOK_SECRET=

# WhatsApp Session Configuration
WHATSAPP_SESSION_TTL=1800
WHATSAPP_PERSISTENT_TTL=604800

# WhatsApp Flows (Advanced Features)
WHATSAPP_FLOWS_ENABLED=false
FLOW_ID_ADDRESS_SETUP=
FLOW_ID_KYC=
FLOW_ID_PRODUCT_CREATE=
FLOW_ID_RETURNS=

# ============================================
# Frontend Configuration
# ============================================
# Vite environment variables (must be prefixed with VITE_)
VITE_API_BASE_URL=/api

# Backend URL for Vite proxy (development only)
VITE_BACKEND_URL=shopply-m221.vercel.app
